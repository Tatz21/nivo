rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Enquiries: Write-only with strict validation, NO public reads
    match /enquiries/{enquiryId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['type', 'name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.email is string
                    && request.resource.data.type in ['education', 'course', 'general', 'resume_support'];
      allow update, delete: if false;
    }

    // Institutional Staffing Requirements: Server/Admin controlled, NO public reads
    match /recruitmentRequirements/{requirementId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['organisationName', 'contactName', 'businessEmail', 'createdAt'])
                    && request.resource.data.organisationName is string
                    && request.resource.data.businessEmail is string;
      allow update, delete: if false;
    }

    // Candidate Submissions: Sensitive personal CV data, NO public reads
    match /candidateSubmissions/{submissionId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string;
      allow update, delete: if false;
    }

    // Resume Documents: Protected by high-entropy secret verified server-side
    // Never allow direct client listing or unauthenticated reads
    match /resumeDocuments/{resumeId} {
      allow read, write: if false;
    }

    // Resume Imports: Temporary holding records, server-managed only
    match /resumeImports/{importId} {
      allow read, write: if false;
    }

    // Admin Audit Logs: Strictly server-only
    match /adminAuditLogs/{logId} {
      allow read, write: if false;
    }
  }
}
